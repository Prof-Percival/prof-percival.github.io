---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  introduction?: string;
  id: string;
}

const { number, eyebrow, title, introduction, id } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">
      {number} / {eyebrow}
    </p>
    <h2 id={id}>{title}</h2>
  </div>
  {introduction && <p>{introduction}</p>}
</div>
