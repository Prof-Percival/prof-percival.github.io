---
import { site } from '../data/site';
import ArrowIcon from './ArrowIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <span class="brand__mark brand__mark--footer" aria-hidden="true">
        PM
      </span>
      <p>Built with care in Cape Town.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href={site.links.github} data-track="github-footer">
        GitHub <ArrowIcon />
      </a>
      <a href={site.links.linkedin} data-track="linkedin-footer">
        LinkedIn <ArrowIcon />
      </a>
      <a href={site.links.resume} data-track="cv-footer">
        CV <ArrowIcon />
      </a>
      <a href="/privacy/">Privacy</a>
    </nav>
    <div class="site-footer__meta">
      <ThemeToggle />
      <small>
        © {new Date().getFullYear()} {site.name}
      </small>
    </div>
  </div>
</footer>
