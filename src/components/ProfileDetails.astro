---
import { certifications, community, languages, linkedInCertificationCount } from '../data/portfolio';
import { site } from '../data/site';
import ArrowIcon from './ArrowIcon.astro';

const certificationGroups = [
  {
    id: 'recent',
    eyebrow: '01 / Recent',
    title: 'Recent eight',
    description: 'Eight recent certifications spanning AI, software engineering, leadership, and technology.',
    start: 1,
    items: certifications.filter((certification) => certification.group === 'recent'),
  },
  {
    id: 'selected',
    eyebrow: '02 / Selected for range',
    title: 'Ten complementary certifications',
    description: 'A cross-section of back-end, full-stack, cloud, data, security, and accessibility learning.',
    start: 9,
    items: certifications.filter((certification) => certification.group === 'selected'),
  },
] as const;
---

<div class="profile-details">
  <section id="credentials" class="credentials indexed-section" aria-labelledby="credentials-title">
    <div class="profile-subheading">
      <p class="eyebrow">Selected certifications</p>
      <div>
        <h3 id="credentials-title">Evidence of continuous learning.</h3>
        <p>Eighteen shown from {linkedInCertificationCount}+ certifications listed on LinkedIn.</p>
      </div>
    </div>
    <div class="credential-groups">
      {certificationGroups.map((group) => (
        <section class="credential-group" aria-labelledby={`credential-group-${group.id}`}>
          <header class="credential-group__header">
            <div>
              <p class="eyebrow">{group.eyebrow}</p>
              <h4 id={`credential-group-${group.id}`}>{group.title}</h4>
            </div>
            <p>{group.description}</p>
          </header>
          <div class="credential-grid" data-certification-group={group.id}>
            {group.items.map((credential, index) => (
              <a
                href={'url' in credential ? credential.url : site.links.linkedinCertifications}
                target="_blank"
                rel="noopener noreferrer"
                data-track={'url' in credential ? 'credential-open' : 'linkedin-certification-open'}
                data-credential-source={'url' in credential ? 'issuer' : 'linkedin'}
              >
                <span class="credential-card__number">{String(group.start + index).padStart(2, '0')}</span>
                <div class="credential-card__copy">
                  <span class="credential-card__category">{credential.category}</span>
                  <strong>{credential.title}</strong>
                  <small>
                    {credential.issuer} · {credential.issued}
                  </small>
                </div>
                <ArrowIcon />
                <span class="sr-only">
                  {'url' in credential ? 'Verify credential.' : 'View this certification on LinkedIn.'} (opens in a new
                  tab)
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <a
      class="text-link credentials__all"
      href={site.links.linkedinCertifications}
      target="_blank"
      rel="noopener noreferrer"
      data-track="linkedin-credentials"
    >
      View all certifications on LinkedIn <ArrowIcon />
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </section>

  <div class="profile-details__secondary">
    <section id="languages" class="language-section indexed-section" aria-labelledby="languages-title">
      <div class="profile-subheading">
        <p class="eyebrow">Languages</p>
        <h3 id="languages-title">Able to work across more than one language and context.</h3>
      </div>
      <dl class="language-list">
        {languages.map((language) => (
          <div>
            <dt>{language.name}</dt>
            <dd>{language.proficiency}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="community" class="community-section indexed-section" aria-labelledby="community-title">
      <div class="profile-subheading">
        <p class="eyebrow">Early experience and community</p>
        <h3 id="community-title">Learning by helping other people move forward.</h3>
      </div>
      <div class="community-list">
        {community.map((item) => (
          <article>
            <span>{item.period}</span>
            <h4>{item.role}</h4>
            <p>{item.organization}</p>
            <small>{item.summary}</small>
          </article>
        ))}
      </div>
    </section>
  </div>
</div>
