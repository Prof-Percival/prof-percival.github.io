---
interface Props {
  direction?: 'down' | 'up-right' | 'left' | 'right';
}

const { direction = 'up-right' } = Astro.props;
const paths = {
  down: 'M12 4v14m0 0 5-5m-5 5-5-5',
  'up-right': 'M7 17 17 7m0 0H9m8 0v8',
  left: 'm11 17-5-5 5-5M6 12h12',
  right: 'm13 7 5 5-5 5m5-5H6',
};
---

<svg class="inline-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
  <path d={paths[direction]}></path>
</svg>
