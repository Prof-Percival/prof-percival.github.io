<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light mode">
  <span class="theme-toggle__track" aria-hidden="true">
    <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="14" height="14">
      <circle cx="12" cy="12" r="3.5"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
    </svg>
    <span class="theme-toggle__thumb"></span>
    <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="13" height="13">
      <path d="M20 15.1A8.5 8.5 0 0 1 8.9 4a8.5 8.5 0 1 0 11.1 11.1Z"></path>
    </svg>
  </span>
  <span class="sr-only" data-theme-label>
    Dark theme active
  </span>
</button>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const updateToggles = (theme: 'dark' | 'light') => {
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`);
      const label = toggle.querySelector<HTMLElement>('[data-theme-label]');
      if (label) label.textContent = `${theme === 'dark' ? 'Dark' : 'Light'} theme active`;
    });
  };

  updateToggles(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      document.documentElement.style.colorScheme = next;
      document.querySelector('[data-theme-color]')?.setAttribute('content', next === 'light' ? '#f4f0e8' : '#090d12');
      localStorage.setItem('portfolio-theme', next);
      updateToggles(next);
    });
  });
</script>
