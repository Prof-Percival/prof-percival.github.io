---
import { portfolioRoutes, type PortfolioRouteId } from '../data/navigation';
import ArrowIcon from './ArrowIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  active?: PortfolioRouteId;
}

const { active } = Astro.props;
const compactRoutes = portfolioRoutes.filter((route) => route.id !== 'home');
---

<header class="site-header" data-site-header>
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">
        PM
      </span>
      <span class="brand__text">
        <strong>Phadima Percival Maredi</strong>
        <small>Software Engineer</small>
      </span>
      <span class="sr-only">, home</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {compactRoutes.map((route) => (
        <a href={route.href} aria-current={active === route.id ? 'page' : undefined}>
          {route.label}
        </a>
      ))}
      <a href="/profile/#contact">Contact</a>
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Open navigation">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {portfolioRoutes.map((route) => (
          <a href={route.href} aria-current={active === route.id ? 'page' : undefined}>
            {route.label}
          </a>
        ))}
        <a href="/profile/#contact">Contact</a>
      </nav>
    </details>

    <div class="site-header__actions">
      <ThemeToggle />
      <a
        class="header-resume"
        href="/resume/percival-maredi-cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        data-track="cv-header"
      >
        CV <ArrowIcon /> <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</header>
