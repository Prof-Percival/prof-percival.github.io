---
import AppShell from '../components/AppShell.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Phadima Percival Maredi"
  description="The requested portfolio page could not be found."
  noindex
>
  <AppShell>
    <main id="main" class="not-found shell">
      <div class="not-found__code" aria-hidden="true">
        404
      </div>
      <p class="eyebrow">Page not found</p>
      <h1>This path ends here. The work continues elsewhere.</h1>
      <p>The page may have moved, or the address may be incomplete.</p>
      <a class="button button--primary" href="/">
        Return to the portfolio <ArrowIcon direction="left" />
      </a>
    </main>
  </AppShell>
</BaseLayout>
