---
import AppShell from '../components/AppShell.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import HubRoutes from '../components/HubRoutes.astro';
import SystemsMap from '../components/SystemsMap.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <AppShell active="home">
    <main id="main" class="hub-page">
      <section class="hub-hero shell" id="top" aria-labelledby="hero-title">
        <div class="hub-hero__copy">
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span> Software Engineer · Cape Town
          </p>
          <h1 id="hero-title">I build dependable systems for the moments that matter.</h1>
          <p class="hub-hero__intro">
            Full-stack product engineering with strong back-end depth across cloud infrastructure, data-intensive
            systems, and software people need to trust.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="/work/">
              Explore the systems <ArrowIcon />
            </a>
            <a class="text-link" href="#routes">
              Choose your route <ArrowIcon direction="down" />
            </a>
          </div>
          <dl class="hero__facts">
            <div>
              <dt>Current</dt>
              <dd>{site.currentCompany}</dd>
            </div>
            <div>
              <dt>Previously</dt>
              <dd>Amazon EC2 · OLX</dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>{site.location}</dd>
            </div>
          </dl>
        </div>
        <div class="hub-hero__map">
          <SystemsMap />
          <p>
            <span>Live portfolio map</span> Select a node to inspect how the work connects.
          </p>
        </div>
      </section>

      <HubRoutes />
    </main>
  </AppShell>
</BaseLayout>
