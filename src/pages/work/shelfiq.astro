---
import AppShell from '../../components/AppShell.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ShelfIqVisual from '../../components/ShelfIqVisual.astro';
import ShelfIqWorkflow from '../../components/ShelfIqWorkflow.astro';
import { shelfIqProject as project } from '../../data/shelfiq';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`${project.title} | In-development project | Phadima Percival Maredi`}
  description={`${project.summary} An in-development project story by Phadima Percival Maredi.`}
>
  <AppShell active="work">
    <main id="main">
      <article class="case-study case-study--shelfiq">
        <header class="case-study__hero shell">
          <a class="text-link case-study__back" href="/work/">
            <ArrowIcon direction="left" /> Back to work
          </a>
          <p class="eyebrow">Project story / {project.eyebrow}</p>
          <h1>{project.title}</h1>
          <p class="case-study__summary">{project.summary}</p>
          <div class="case-study__badges">
            <span>{project.status}</span>
            <span>{project.sourceLabel}</span>
            <span>{project.launchLabel}</span>
          </div>
          <ul class="tag-list" aria-label="ShelfIQ technologies">
            {project.stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </header>

        <div class="case-study__visual shell">
          <ShelfIqVisual />
        </div>
        <ShelfIqWorkflow />

        <div class="case-study__body shell">
          <section aria-labelledby="shelfiq-problem-title">
            <p class="eyebrow">01 / Product problem</p>
            <h2 id="shelfiq-problem-title">Expiry awareness starts with a trustworthy product record.</h2>
            <p>{project.problem}</p>
          </section>

          <section aria-labelledby="shelfiq-system-title">
            <p class="eyebrow">02 / Current system</p>
            <h2 id="shelfiq-system-title">Layered around product, verification, and media boundaries.</h2>
            <p>{project.contribution}</p>
            <div class="surface-grid surface-grid--four">
              {project.architecture.map((surface, index) => (
                <article>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>{surface.label}</h3>
                  <p>{surface.detail}</p>
                </article>
              ))}
            </div>
          </section>

          <section aria-labelledby="shelfiq-capabilities-title">
            <p class="eyebrow">03 / Implemented today</p>
            <h2 id="shelfiq-capabilities-title">The story starts with what the source can already prove.</h2>
            <ul class="shelfiq-capabilities">
              {project.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="shelfiq-delivery-title">
            <p class="eyebrow">04 / Before public release</p>
            <h2 id="shelfiq-delivery-title">Four engineering gates remain before public release.</h2>
            <p>No launch, customer usage, or production outcome is claimed. These are the next engineering gates.</p>
            <div class="decision-list shelfiq-delivery-list">
              {project.deliveryGates.map((gate, index) => (
                <article>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{gate.title}</h3>
                    <p>{gate.detail}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="case-study__closing" aria-labelledby="shelfiq-closing-title">
            <p class="eyebrow">05 / Current position</p>
            <h2 id="shelfiq-closing-title">Implemented product boundaries, with release work still open.</h2>
            <p>
              ShelfIQ demonstrates product modelling and full-stack system boundaries today. The page will evolve with
              the product, and public-delivery evidence will replace the in-development status only after release.
            </p>
            <a class="button button--primary" href="/profile/#contact">
              Discuss ShelfIQ <ArrowIcon />
            </a>
          </section>
        </div>
      </article>
    </main>
  </AppShell>
</BaseLayout>
